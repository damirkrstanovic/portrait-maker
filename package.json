{
  "name": "pathfinder-portrait-manager",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "benchmark:seed": "node scripts/seed-benchmark.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "package": "node scripts/package.mjs",
    "package:linux": "bash scripts/package-linux.sh",
    "package:windows": "tauri build --bundles nsis,msi --ci",
    "package:macos": "tauri build --bundles app,dmg --ci"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.13",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@playwright/test": "1.64.0-alpha-2026-09-14",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
